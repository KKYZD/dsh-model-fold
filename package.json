{
  "name": "dsh-model-fold",
  "version": "1.0.0",
  "description": "ZCode-style model picker for the DSH web GUI — provider submenus that open upward, reasoning-effort selection, and keyboard navigation. · DSH 的 ZCode 式模型选择器：向上展开的提供方子菜单、推理等级选择与键盘导航。",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh",
    "model-picker",
    "reasoning-effort",
    "composer"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKYZD/dsh-model-fold.git"
  },
  "homepage": "https://github.com/KKYZD/dsh-model-fold#readme",
  "bugs": {
    "url": "https://github.com/KKYZD/dsh-model-fold/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
